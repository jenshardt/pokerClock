# Copy this file to .env and set secure values before running docker compose.
# Keep .env out of version control.

POSTGRES_PASSWORD=change-me-to-a-strong-password
DB_PASSWORD=change-me-to-a-strong-password
# Both values must be identical for the PostgreSQL user "postgres".

# Optional local Docker secret overriding the initial demo users.
# Leave empty to use secrets/users.example.json.
APP_SEED_USERS_FILE=
